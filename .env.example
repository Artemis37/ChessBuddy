# Copy this file to .env and fill in your key. .env is git-ignored.
ANTHROPIC_API_KEY=

# Learn openings: how often each move is played, from the Lichess opening explorer. A personal
# token from https://lichess.org/account/oauth/token (no scopes); without it the percentages are hidden.
# LICHESS_TOKEN=

# Optional overrides
# API_PORT=3001
# COACH_MODEL=claude-sonnet-5-5
# COACH_EFFORT=medium
# STOCKFISH_IMAGE=chessbuddy/mcp-stockfish
# ANALYSIS_DEPTH=16
# Engines that grade moves at once (1 to 8, default 1); reviewing a game grades that many moves
# at a time. Locally each is its own Docker container, besides the bot's.
# GRADING_ENGINES=1

# Sign-in. Without SESSION_SECRET a random one is used and restarts sign you out.
# Without SQL_CONNECTION_STRING only the owner account (kviiilyn37_) exists.
# SESSION_SECRET=
# SQL_CONNECTION_STRING=Server=tcp:<server>.database.windows.net,1433;Initial Catalog=<database>;User ID=<user>;Password=<password>;Encrypt=True;
# The owner's password hash, from: npm run password:hash -- "<password>". Without it, the
# default hash in server/auth/users.ts is used.
# OWNER_PASSWORD_HASH=scrypt$16384$8$1$...

# Use the HTTP engine container (npm run engine:build:http) instead of starting Docker containers.
# ENGINE_URL=http://localhost:8080/mcp
# ENGINE_TOKEN=
