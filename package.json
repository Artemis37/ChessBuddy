{
  "name": "chessbuddy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local chess learning app: play the bot or both sides, get every move of yours graded and explained.",
  "scripts": {
    "engine:build": "docker build --target stdio -t chessbuddy/mcp-stockfish -f docker/mcp-stockfish.Dockerfile docker",
    "engine:build:http": "docker build --target http -t chessbuddy/engine-http -f docker/mcp-stockfish.Dockerfile docker",
    "web:build": "docker build -t chessbuddy/web .",
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch-path=server --watch-path=shared --import tsx server/index.ts",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "calibrate": "tsx scripts/calibrate-bot.ts",
    "openings:build": "tsx scripts/build-openings.ts",
    "password:hash": "tsx scripts/hash-password.ts"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.1.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "chess.js": "1.4.0",
    "express": "5.3.0",
    "mssql": "12.7.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.23.15",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/mssql": "12.3.0",
    "@types/node": "20.19.25",
    "@types/react": "18.3.26",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.2.1",
    "typescript": "5.9.3",
    "vite": "6.4.1",
    "vitest": "3.2.4"
  }
}
